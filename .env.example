# ACRA MES — Docker Compose environment template (ACR-42 / A10-1).
# Copy to .env at the repo root. Compose reads it automatically. Never commit the populated .env.
#
#   cp .env.example .env
#
# This file configures the CONTAINERIZED stack only. Running the backend or frontend directly on
# your host still uses backend/.env and frontend/.env.local.

# --- Published host ports -------------------------------------------------
# Defaults match the documented ones. Override any that are already taken — this repo is often
# checked out into several worktrees at once, each wanting the same ports.
#
# Changing ACRA_BACKEND_PORT requires rebuilding the frontend image (`docker compose up --build`),
# because NEXT_PUBLIC_API_URL is compiled into the browser bundle rather than read at runtime.
ACRA_DB_PORT=5433
ACRA_BACKEND_PORT=8000
ACRA_FRONTEND_PORT=3000

# --- Container names ------------------------------------------------------
# Container names are global to the Docker daemon, so two worktrees running the default names
# collide. Give each checkout its own set, or use `docker compose -p <project>`.
ACRA_DB_CONTAINER=acra-postgres
ACRA_MIGRATE_CONTAINER=acra-migrate
ACRA_BACKEND_CONTAINER=acra-backend
ACRA_FRONTEND_CONTAINER=acra-frontend

# --- Auth / JWT -----------------------------------------------------------
# Generate a unique value, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- AI receiving-document extraction (OCR) -------------------------------
# Optional. Leave blank to run everything except the receiving/OCR extraction flow.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Set to true to run the receiving/OCR flow on a canned extraction instead of calling
# Gemini/Claude — no API key, no network call. Upload
# backend/tests/fixtures/ocr/sample_bol_gridded.png on the Receiving page to see it end to end.
# This is the way to exercise the full app with no credentials; see README "Running OCR without
# an API key".
OCR_MOCK_MODE=false

# --- Observability --------------------------------------------------------
# Request-log format: "text" (human-readable, default) or "json" (one structured object per line
# with method, route, status, duration_ms, request_id). Set json when you want to parse
# `docker compose logs backend`.
LOG_FORMAT=text
