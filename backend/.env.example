# ACRA MES — backend environment template.
# Copy to backend/.env and fill in real values. Never commit the populated .env.
#
#   cp backend/.env.example backend/.env

# --- Database -------------------------------------------------------------
# Async SQLAlchemy DSN. Use port 5433 with the Docker Compose Postgres in this repo;
# use 5432 for a locally installed PostgreSQL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/acra_db

# Browser origins allowed to call this API, comma-separated. Defaults to the frontend's
# documented dev port; override to run the frontend on another port (a second worktree, or an
# e2e run against a free port) — a mismatch here shows up as every XHR being CORS-blocked.
CORS_ORIGINS=http://localhost:3000

# --- Auth / JWT -----------------------------------------------------------
# Generate a unique random secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- AI receiving-document extraction (OCR) -------------------------------
# Only needed for the receiving/OCR flow. Leave as placeholders to run the rest of the app.
# Extractor: Anthropic Claude — Haiku 5.5 primary, Sonnet 5.5 fallback.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional overrides (defaults shown). An empty ANTHROPIC_FALLBACK_MODEL disables the fallback.
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_FALLBACK_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=medium
# No API key? Set this instead and the receiving/OCR flow returns a canned extraction result
# (no Claude call) — upload backend/tests/fixtures/ocr/sample_bol_gridded.png to try it.
# OCR_MOCK_MODE=true

# --- Observability --------------------------------------------------------
# Request-log format: "text" (human-readable console, default) or "json" (one structured object
# per line: method, route template, status, duration_ms, request_id). Every response also carries
# an X-Request-ID header, which is echoed back if the client supplies one — though on a 500 it is
# readable only server-side or same-origin (see the README's "Benchmarks and request logs").
LOG_FORMAT=text
